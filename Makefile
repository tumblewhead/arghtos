	$(CLANG) $(M23_COMMON) -flto -fomit-frame-pointer -fno-jump-tables \
		-DARGHTOS_ENTRY_NEXT_OVERLAY=1 -DARGHTOS_R5AF_ASM_HARDFAULT_ENTRY=1 -DARGHTOS_R5AG_LINK_ALIAS_TERMINAL=1 -c port/cortex_m23/arghtos_port.c \
