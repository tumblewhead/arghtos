		-fuse-ld=lld -Wl,--gc-sections \
		-Wl,--defsym=arghtos_port_fault_terminal=arghtos_m23_board_fault_terminal \
		-Wl,-Map=$(BUILD)/m23-r6k.map \
		-Wl,-T,footprint/m23_prebuilt_context.ld -o $(BUILD)/m23-r6k.elf \
		$(BUILD)/arghtos_kernel_m23_r6k.o \
		$(BUILD)/arghtos_port_m23_r6k.o \
		$(BUILD)/arghtos_context_m23_r6k.o \
		$(BUILD)/m23_prebuilt_stacks_r6k.o \
		$(BUILD)/m23_board_stub_r6k.o \
		$(BUILD)/m23_footprint_r6k.o
	size -A $(BUILD)/m23-r6k.elf
	$(PYTHON) tools/footprint_report.py --map $(BUILD)/m23-r6k.map \
		--msp $(M23_ARGHTOS_MSP_R5T) --json \
		> $(BUILD)/footprint-r6k.json
	cat $(BUILD)/footprint-r6k.json

