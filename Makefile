		-Wl,-T,footprint/m23_prebuilt_context.ld -o $(BUILD)/m23-r6s.elf \
		$(BUILD)/arghtos_kernel_m23_r6s.o \
		$(BUILD)/arghtos_port_m23_r6s.o \
		$(BUILD)/arghtos_context_m23_r6s.o \
		$(BUILD)/m23_prebuilt_stacks_r6s.o \
		$(BUILD)/m23_board_stub_r6s.o \
		$(BUILD)/m23_footprint_r6s.o
	size -A $(BUILD)/m23-r6s.elf
	$(PYTHON) tools/footprint_report.py --map $(BUILD)/m23-r6s.map \
		--msp $(M23_ARGHTOS_MSP_R5T) --json \
		> $(BUILD)/footprint-r6s.json
