		-o $(BUILD)/arghtos_context_m23_r6q-physical.o
	$(CLANG) $(M23_COMMON) -flto -fomit-frame-pointer -fno-jump-tables -c footprint/m23_board_stub.c \
		-o $(BUILD)/m23_board_stub_r6q-physical.o
